{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,
    "esModuleInterop": true,

    /* Node mode — imports carry a .ts extension for the type-stripped dev loop,
       and are rewritten to .js on emit so `build` output runs on plain node. */
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    /* Linting — `erasableSyntaxOnly` bans the syntax Node cannot strip (enums,
       parameter properties, namespaces), so dev and build cannot diverge. */
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Emit */
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src"]
}
