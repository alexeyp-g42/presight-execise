{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,
    "esModuleInterop": true,

    /* The dev loop runs the .ts sources through Node's native type stripping,
       so relative imports carry a .ts extension. `rewriteRelativeImportExtensions`
       rewrites them to .js on the way out, which is what lets `build` emit real
       JS that plain `node` can run. */
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    /* Node strips types, it does not execute them. `erasableSyntaxOnly` bans the
       syntax that would need a transpiler — enums, parameter properties,
       namespaces — so the stripped dev path and the tsc build path cannot diverge. */
    "erasableSyntaxOnly": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src"]
}
