{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,
    "esModuleInterop": true,

    /* The avatar style ships as a JSON definition, imported with a type
       attribute. Node resolves it natively; without this, only TypeScript
       cannot see it. Nothing here imports JSON from `src` — a bare specifier
       into `node_modules` is not copied into `dist` and needs no emit. */
    "resolveJsonModule": true,

    /* Node mode — imports carry a .ts extension for the type-stripped dev loop,
       and are rewritten to .js on emit so `build` output runs on plain node. */
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    /* Linting — `erasableSyntaxOnly` bans the syntax Node cannot strip (enums,
       parameter properties, namespaces), so dev and build cannot diverge. */
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Emit — this config only checks; `tsconfig.build.json` narrows to `src`
       and turns the emit back on. Editors pick this one up, so test files get
       the same settings as the code they exercise. */
    "noEmit": true,
    "sourceMap": true
  },
  "include": ["src", "test", "vitest.config.ts", "drizzle.config.ts"]
}
