{
  "name": "presight-server",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/server/src/db && cp src/db/schema.sql dist/server/src/db/schema.sql",
    "start": "node dist/server/src/main.js",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "~11.5.0",
    "express": "~5.1.0",
    "zod": "~3.23.0"
  },
  "devDependencies": {
    "@faker-js/faker": "~9.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "~5.0.1",
    "@types/node": "~22.9.0",
    "@types/node-fetch": "~2.6.12",
    "@types/supertest": "^7.2.1",
    "supertest": "~7.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "~2.1.0"
  }
}
