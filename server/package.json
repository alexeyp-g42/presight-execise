{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "DATABASE_PATH=\"${DATABASE_PATH:-../data/presight.sqlite}\" node --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "seed": "DATABASE_PATH=\"${DATABASE_PATH:-../data/presight.sqlite}\" node src/db/seed.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@dicebear/core": "~10.3.2",
    "@dicebear/styles": "~10.2.0",
    "@faker-js/faker": "~10.5.0",
    "@presight/shared": "workspace:*",
    "better-sqlite3": "~13.0.2",
    "drizzle-orm": "~0.45.2",
    "express": "~5.1.0",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "~5.0.1",
    "@types/node": "^24.13.2",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "supertest": "^7.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.10"
  }
}
